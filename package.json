{
  "name": "voyage-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "supabase db push",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/sql.mjs supabase/seed.sql && node scripts/sql.mjs supabase/seed-india.sql && node scripts/seed-auth.mjs",
    "db:types": "node scripts/gen-types.mjs > src/lib/db/generated.ts",
    "db:verify": "node scripts/sql.mjs supabase/verify.sql",
    "test:disruption": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-disruption.mts",
    "test:field": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-field.mts",
    "test:apply": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-apply.mts",
    "test:flow": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-flow.mts",
    "test:realtime": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-realtime.mts",
    "test:agent": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-agent.mts",
    "test:all": "npm run db:seed && npm run db:verify && npm run test:disruption && npm run test:field && npm run test:apply && npm run test:flow && npm run test:realtime && npm run db:seed",
    "test:concierge": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-concierge.mts",
    "test:copilot": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-copilot.mts",
    "test:intake": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-intake.mts",
    "test:research": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-research.mts",
    "test:abroad": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-compose-abroad.mts",
    "test:assignment": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-assignment.mts",
    "research:warm": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/warm-cache.mts",
    "test:cache": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-cache.mts",
    "db:seed:auth": "node scripts/seed-auth.mjs",
    "test:rls": "tsx --conditions=react-server scripts/test-rls.mts",
    "test:replan-tools": "VOYAGE_SERVICE_ROLE=1 tsx --conditions=react-server scripts/test-replan-tools.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "gsap": "^3.12.7",
    "lenis": "^1.3.26",
    "lucide-react": "^0.474.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "pg": "^8.23.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
