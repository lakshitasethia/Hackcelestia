# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Supabase → Project Settings → API
# The URL and anon key are safe in the browser (they are protected by RLS) and
# are the only two that carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only — it must never appear in any file
# under a "use client" directive, and never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database. Used by the CLI for `db push`.
SUPABASE_DB_PASSWORD=

# Optional, and the fix for `ENOTFOUND db.<ref>.supabase.co`. The direct host
# publishes only an AAAA record, so on a network without IPv6 — much
# conference wifi, many VPNs — no script that talks SQL can reach it, and the
# error looks identical to a deleted project. The pooler is dual-stack. Copy
# it from Settings → Database → Connection string → Transaction pooler; when
# set, every script here uses it in preference to the direct host.
SUPABASE_DB_URL=

# Optional. The password given to the three seeded demo accounts
# (ananya@example.com, ops@costiera-dmc.example, marco@costiera-dmc.example)
# by `scripts/seed-auth.mjs`. Defaults to voyage-demo-2026.
DEMO_PASSWORD=

# console.groq.com → API Keys. Free tier, no card required. Server-side only;
# the re-planner reads it. This is what drives the agent.
GROQ_API_KEY=

# Optional override. Defaults to openai/gpt-oss-120b. Verify options against
# `GET https://api.groq.com/openai/v1/models` rather than the docs — the tool-use
# page is stale. Alternatives with tool support: qwen/qwen3.6-27b,
# openai/gpt-oss-20b. Not groq/compound* — those only do Groq's built-in tools.
GROQ_MODEL=

# Optional override for the three chat agents — the concierge, the copilot and
# intake. Defaults to openai/gpt-oss-20b. Kept separate from GROQ_MODEL because
# somebody is waiting on a chat reply and nobody is waiting on a re-plan, and
# because Groq meters tokens per model: a busy chat cannot then rate-limit the
# re-plan it is about to demonstrate.
GROQ_CHAT_MODEL=

# Optional. Without it the disruption injector uses seeded weather, which is
# what the demo runs on anyway — a live API that flakes on stage is a liability.
OPENWEATHER_API_KEY=

# ------------------------------------------------------------------- auth --

# Optional. The site URL OAuth returns to. Leave unset and each request infers
# it from its own Host header, which is right in dev and right on Vercel; set
# it explicitly behind a proxy that rewrites the host.
NEXT_PUBLIC_SITE_URL=

# Optional escape hatch. Anything other than "false" (including unset) means
# /app, /ops, /field, /trip and /plan require a signed-in user, and every read
# goes through RLS as that user.
#
# Setting it to "false" turns off BOTH: no sign-in wall, and reads fall back to
# the service role. It has to be both — dropping only the wall would let an
# anonymous visitor reach /ops and find it blank, because RLS answers an
# unauthenticated read with no rows.
#
# So this switches off the data boundary, not just the door. It exists so a
# broken login shortly before a demo costs you a talking point instead of the
# whole run. Do not leave it set.
AUTH_ENFORCED=

# Optional. Set to "off" to hide the "Continue with Google" button. Worth doing
# until the provider is actually configured, because Supabase rejects an
# unconfigured provider at its own /authorize endpoint and the user lands on
# raw JSON that this app never gets a chance to intercept.
#
# To configure it, both halves are required:
#   1. Google Cloud console → APIs & Services → Credentials → OAuth client ID
#      (type: Web application). Authorized redirect URI must be exactly
#      https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google → enable, and paste that
#      client ID and secret in.
# Supabase → Authentication → URL Configuration also needs http://localhost:3000
# and the deployed origin in "Redirect URLs", or the callback is refused.
NEXT_PUBLIC_GOOGLE_AUTH=
