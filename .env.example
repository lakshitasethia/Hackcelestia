# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Supabase → Project Settings → API
# The URL and anon key are safe in the browser (they are protected by RLS) and
# are the only two that carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only — it must never appear in any file
# under a "use client" directive, and never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database. Used by the CLI for `db push`.
SUPABASE_DB_PASSWORD=

# console.groq.com → API Keys. Free tier, no card required. Server-side only;
# the re-planner reads it. This is what drives the agent.
GROQ_API_KEY=

# Optional override. Defaults to openai/gpt-oss-120b. Verify options against
# `GET https://api.groq.com/openai/v1/models` rather than the docs — the tool-use
# page is stale. Alternatives with tool support: qwen/qwen3.6-27b,
# openai/gpt-oss-20b. Not groq/compound* — those only do Groq's built-in tools.
GROQ_MODEL=

# Optional. Without it the disruption injector uses seeded weather, which is
# what the demo runs on anyway — a live API that flakes on stage is a liability.
OPENWEATHER_API_KEY=
