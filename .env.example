# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Supabase → Project Settings → API
# The URL and anon key are safe in the browser (they are protected by RLS) and
# are the only two that carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only — it must never appear in any file
# under a "use client" directive, and never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database. Used by the CLI for `db push`.
SUPABASE_DB_PASSWORD=

# The fix for `ENOTFOUND db.<ref>.supabase.co`, and worth setting before you
# need it. The direct host publishes only an AAAA record, so on a network
# without IPv6 — much conference wifi, many VPNs — no script that talks SQL
# can reach it, and the error looks identical to a deleted project.
#
# The pooler is dual-stack. Set the HOST only: the scripts assemble the rest
# from SUPABASE_DB_PASSWORD above, so rotating that password does not leave a
# stale copy of it in a second variable. Find the host in Settings → Database
# → Connection string → Transaction pooler; it looks like
# aws-0-<region>.pooler.supabase.com and the region is the project's, not
# yours. Port defaults to 5432 (session mode), which is what the seed needs.
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=

# Alternative to the two above: a complete connection string, which wins over
# everything if set. Convenient for a one-off, but it embeds the password.
SUPABASE_DB_URL=

# Optional. The password given to the three seeded demo accounts
# (ananya@example.com, ops@costiera-dmc.example, marco@costiera-dmc.example)
# by `scripts/seed-auth.mjs`. Defaults to voyage-demo-2026.
DEMO_PASSWORD=

# console.groq.com → API Keys. Free tier, no card required. Server-side only;
# the re-planner reads it. This is what drives the agent.
GROQ_API_KEY=

# Optional override. Defaults to openai/gpt-oss-120b. Verify options against
# `GET https://api.groq.com/openai/v1/models` rather than the docs — the tool-use
# page is stale. Alternatives with tool support: qwen/qwen3.6-27b,
# openai/gpt-oss-20b. Not groq/compound* — those only do Groq's built-in tools.
GROQ_MODEL=

# Optional override for the research agent — the only thing here that touches
# the internet. Defaults to groq/compound-mini, whose built-in web_search Groq
# runs server-side, so no second search vendor or API key is needed.
#
# Two constraints before you change it. Its context is small and Groq injects
# whole fetched pages into it, so a request that triggers several searches comes
# back 413 rather than an answer — the research agent asks for one search per
# pass for that reason. And it runs on openai/gpt-oss-120b underneath, so its
# tokens come out of that model's daily allowance (200k on the free tier); a
# heavy re-plan and a research pass compete for the same pool.
#
# openai/gpt-oss-120b with Groq's browser_search tool reads pages far better,
# but bills you the fetched page content: one city query measured 153k prompt
# tokens. Worth it on a paid tier, unusable on the free one.
GROQ_RESEARCH_MODEL=

# Optional override for the three chat agents — the concierge, the copilot and
# intake. Defaults to openai/gpt-oss-20b. Kept separate from GROQ_MODEL because
# somebody is waiting on a chat reply and nobody is waiting on a re-plan, and
# because Groq meters tokens per model: a busy chat cannot then rate-limit the
# re-plan it is about to demonstrate.
GROQ_CHAT_MODEL=

# Two things about Groq's free tier, both of which cost a day to find out:
#
#   1. Limits are per ORGANIZATION, not per key. Rotating the key changes
#      nothing — a second key on the same account shares the same allowance.
#      A fresh budget means a different Groq account, or the Dev tier.
#   2. openai/gpt-oss-120b allows 8,000 tokens per MINUTE, and groq/compound-mini
#      runs on it. One web search costs about 7,500. So the real ceiling is
#      roughly one search a minute, whatever the daily number says.
#
# That second one is why price verification is offline work rather than part of
# a request somebody is waiting on. The interactive path plans the whole trip
# from the model in about twelve seconds and labels its prices as estimates;
# `npm run research:warm "<prompt>"` then spends a few paced minutes checking
# the important ones against live pages and writes the result to the cache, so
# every later request for that trip gets the citations for free.

# Optional, and the thing that keeps a demo alive when the day's Groq budget is
# gone. `src/lib/agent/providers.ts` holds a chain — Groq, then Mistral, then
# Gemini — and the runtime moves along it when Groq reports the DAILY budget
# spent (a per-minute breach is waited out instead, because that one does clear).
# A provider with no key is skipped entirely: an empty fallback is not a
# fallback, it is a second failure.
#
# Groq stays first because it is the fastest and the prompts are tuned against
# gpt-oss. After a switch the model NAME cannot travel with the request —
# openai/gpt-oss-120b is a 404 at Mistral — so each provider's own model is used
# and only the role carries across.
#
# Measured 6 Sep 2026 on free keys:
#   mistral  ministral-14b-latest   works, and calls tools. This is the default.
#            mistral-small/medium   429 to everything — tier-locked, not a
#                                   burst. Do not set MISTRAL_MODEL to these.
#   gemini   gemini-3.6-flash       generates fine. Google Search grounding
#                                   still needs billing, so it does NOT close
#                                   the price-verification gap above.
#
# `npm run test:failover` checks the chain, and spends a few hundred real tokens
# proving a tool loop finishes on the fallback.
MISTRAL_API_KEY=
MISTRAL_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional. Which operator picks up a trip the traveler planned for themselves.
#
# A composed trip has no operator of its own, and without one it never reaches
# the operator's board (`operator_id = current_operator_id()`) or the guide's
# run sheet — so every disruption and re-plan feature is unreachable from it.
# Accepting a proposal assigns this operator and inherits its coordinator.
#
# Unset, the oldest operator row is used, which is the one the deployment was
# seeded around. The "Voyage Research" operator is never chosen: it exists to
# own unverified catalogue rows and has nobody to answer a phone.
VOYAGE_DEFAULT_OPERATOR_ID=

# Optional. Without it the disruption injector uses seeded weather, which is
# what the demo runs on anyway — a live API that flakes on stage is a liability.
OPENWEATHER_API_KEY=

# ------------------------------------------------------------------- auth --

# Optional. The site URL OAuth returns to. Leave unset and each request infers
# it from its own Host header, which is right in dev and right on Vercel; set
# it explicitly behind a proxy that rewrites the host.
NEXT_PUBLIC_SITE_URL=

# Optional escape hatch. Anything other than "false" (including unset) means
# /app, /ops, /field, /trip and /plan require a signed-in user, and every read
# goes through RLS as that user.
#
# Setting it to "false" turns off BOTH: no sign-in wall, and reads fall back to
# the service role. It has to be both — dropping only the wall would let an
# anonymous visitor reach /ops and find it blank, because RLS answers an
# unauthenticated read with no rows.
#
# So this switches off the data boundary, not just the door. It exists so a
# broken login shortly before a demo costs you a talking point instead of the
# whole run. Do not leave it set.
AUTH_ENFORCED=

# Optional. Set to "off" to hide the "Continue with Google" button. Worth doing
# until the provider is actually configured, because Supabase rejects an
# unconfigured provider at its own /authorize endpoint and the user lands on
# raw JSON that this app never gets a chance to intercept.
#
# To configure it, both halves are required:
#   1. Google Cloud console → APIs & Services → Credentials → OAuth client ID
#      (type: Web application). Authorized redirect URI must be exactly
#      https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google → enable, and paste that
#      client ID and secret in.
# Supabase → Authentication → URL Configuration also needs http://localhost:3000
# and the deployed origin in "Redirect URLs", or the callback is refused.
NEXT_PUBLIC_GOOGLE_AUTH=
